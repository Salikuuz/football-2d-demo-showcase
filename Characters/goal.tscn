[sub_resource type="Shader" id="Shader_goal_chroma"]
code = "shader_type canvas_item;

void fragment() {
	vec4 source = texture(TEXTURE, UV);
	float other = max(source.r, source.b);
	float dominance = source.g - other;
	float key = smoothstep(0.10, 0.38, dominance) * smoothstep(0.30, 0.76, source.g);
	float alpha = 1.0 - key;
	if (alpha < 0.025) {
		discard;
	}
	source.g = min(source.g, other + 0.08 + (1.0 - key) * 0.10);
	COLOR = vec4(source.rgb, source.a * alpha) * COLOR;
}
"

